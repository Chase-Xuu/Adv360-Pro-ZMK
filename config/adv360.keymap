/*
 * Zero-Pinky Layout for Kinesis Advantage 360 Pro
 * Configured by Moon for Chase — 2026-03-17
 *
 * Design: Home Row Mods + Symbol Layer + Navigation Layer
 * Goal: Zero static load on pinkies
 *
 * Key positions (for hold-trigger-key-positions):
 *   Left hand:  0-6, 14-20, 28-34, 46-51, 60-64
 *   Left thumb:  35, 36, 52, 65, 66, 67
 *   Right hand: 7-13, 21-27, 39-45, 54-59, 71-75
 *   Right thumb: 37, 38, 53, 68, 69, 70
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L  0  1  2  3  4  5  6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64
#define THUMBS_L 35 36 52 65 66 67
#define KEYS_R  7  8  9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75
#define THUMBS_R 37 38 53 68 69 70

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      /*
       * "Timeless" Home Row Mods (inspired by urob)
       *
       * tapping-term-ms = 280:  Generous window, no rush
       * quick-tap-ms = 175:    Same key double-tap → always letter
       * require-prior-idle-ms = 150: Just typed? → always letter (kills misfire)
       * flavor = "balanced":   Hold only if another key pressed+released
       * hold-trigger-key-positions: Opposite hand only (same-hand = always tap)
       * hold-trigger-on-release: Allows combining multiple mods on same hand
       */
      hml: homerow_mods_left {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS_LEFT";
          #binding-cells = <2>;
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "balanced";
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <KEYS_R THUMBS_R>;
          hold-trigger-on-release;
      };

      hmr: homerow_mods_right {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS_RIGHT";
          #binding-cells = <2>;
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "balanced";
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <KEYS_L THUMBS_L>;
          hold-trigger-on-release;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                                        &mo 3  &kp N6 &kp N7         &kp N8      &kp N9     &kp N0         &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &kp LS(LC(LG(N3)))                                                            &none  &kp Y  &kp U          &kp I       &kp O      &kp P          &kp BSLH
        &mt TAB SPACE &hml LCTRL A &hml LALT S &hml LGUI D &hml LSHFT F &kp G &kp LS(LC(LG(N4)))  &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL         &none  &kp H  &hmr RSHFT J   &hmr RGUI K &hmr RALT L &hmr RCTRL SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                               &mo 1    &kp PG_UP                                      &kp N  &kp M          &kp COMMA   &kp DOT    &kp FSLH       &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT     &kp LGUI &kp BSPC &kp END  &kp PG_DN &kp ENTER &kp SPACE                          &kp UP         &kp DOWN    &kp LBKT   &kp RBKT       &mo 2
      >;
    };

    symbol_layer {
      display-name = "Symbol";
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                                           &trans &trans    &trans    &trans    &trans    &trans &trans
        &trans &kp N7 &kp N8 &kp N9 &trans &trans &trans                                                          &trans &kp STAR  &kp LPAR  &kp LBKT  &kp LBRC  &trans &trans
        &trans &kp N4 &kp N5 &kp N6 &trans &trans &trans        &trans &trans &trans &trans                        &trans &kp FSLH  &kp RPAR  &kp RBKT  &kp RBRC  &trans &trans
        &trans &kp N1 &kp N2 &kp N3 &kp N0 &kp DOT                   &trans &trans                                      &kp BSLH  &kp EQUAL &kp MINUS &kp GRAVE &trans &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans                                  &trans    &trans    &trans    &trans &trans
      >;
    };

    nav_layer {
      display-name = "Nav";
      bindings = <
        &trans &kp F1 &kp F2     &kp F3   &kp F4      &kp F5 &trans                                                          &trans &kp F6   &kp F7   &kp F8  &kp F9  &kp F10 &kp F11
        &trans &trans &kp PG_UP  &kp UP   &kp PG_DN   &trans &trans                                                           &trans &trans   &trans   &trans  &trans  &trans &kp F12
        &trans &trans &kp LEFT   &kp DOWN &kp RIGHT   &trans &trans        &trans &trans &trans &trans                        &trans &kp HOME &kp BSPC &kp DEL &kp END &trans &trans
        &trans &trans &trans     &trans   &trans      &trans                      &trans &trans                                      &trans   &trans   &trans  &trans  &trans &trans
        &trans &trans &trans     &trans   &trans                    &trans &trans &trans &trans &trans &trans                                  &trans   &trans  &trans  &trans &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
